{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".agents/**",
      "skills-lock.json",
      "README.md",
      "HOSTING.txt",
      "database.rules.json",
      "constants.example.js",
      "package.json",
      "package-lock.json",
      "test/**",
      "**/node_modules/**",
      "**/*.bat",
      "**/*.exe",
      "**/*.sh"
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "database": {
      "host": "127.0.0.1",
      "port": 9000
    },
    "ui": {
      "enabled": false
    }
  }
}
